{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_BUILD_NPM_COMMAND": "npm install --legacy-peer-deps"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "resourceClass": "large",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=8192"
      },
      "android": {
        "gradleCommand": "assembleRelease --stacktrace --info"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

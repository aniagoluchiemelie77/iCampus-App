{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_BUILD_NPM_COMMAND": "npm install --legacy-peer-deps"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease --stacktrace -Dorg.gradle.workers.max=2"
      }
    },
    "apk": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease --stacktrace -Dorg.gradle.workers.max=2"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
